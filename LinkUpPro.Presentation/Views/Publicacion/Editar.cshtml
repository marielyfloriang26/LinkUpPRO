@model LinkUpPro.Application.ViewModels.Publicacion.GuardarPublicacionViewModel

@{
    ViewData["Title"] = "Editar Publicación";
    string tipoContenidoInicial = !string.IsNullOrEmpty(Model.YouTubeVideoUrl) ? "Video" : "Imagen";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container py-5" style="max-width: 650px; font-family: 'Inter', sans-serif;">
    <div class="card shadow-sm border-0 p-4" style="border-radius: 12px; background: #ffffff;">
        <h4 class="mb-3 fw-bold text-dark"><i class="bi bi-pencil-square text-primary me-2"></i> Editar Publicación</h4>
        <hr class="text-muted mb-4">

        <form asp-controller="Publicacion" asp-action="Editar" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImagenUrl" />

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <!-- CONTENIDO DE TEXTO -->
            <div class="mb-4">
                <label asp-for="ContenidoTexto" class="form-label fw-semibold text-muted small">Contenido de la publicación</label>
                <textarea asp-for="ContenidoTexto" class="form-control border-secondary-subtle" rows="4" style="resize:none; border-radius: 8px;" placeholder="¿Qué quieres cambiar?"></textarea>
                <span asp-validation-for="ContenidoTexto" class="text-danger small"></span>
            </div>

            <!-- FORMATO OBLIGATORIO -->
            <div class="mb-4">
                <label class="form-label fw-semibold text-muted small"><i class="bi bi-collection"></i> Tipo de Contenido</label>
                <select name="TipoContenido" id="tipoContenidoSelect" class="form-select border-secondary-subtle" style="border-radius: 8px;" onchange="conmutarTipoContenido()">
                    <!option value="Imagen" @(tipoContenidoInicial == "Imagen" ? "selected" : "")>Imagen</!option>
                    <!option value="Video" @(tipoContenidoInicial == "Video" ? "selected" : "")>Video de YouTube</!option>
                </select>
            </div>

            <!--  IMAGEN -->
            <div class="mb-4" id="sectionImagen">
                <label class="form-label fw-semibold text-muted small"><i class="bi bi-image"></i> Imagen Adjunta</label>
                
                @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                {
                    <div class="mb-2">
                        <span class="text-muted d-block small mb-1">Imagen actual:</span>
                        <img src="@Model.ImagenUrl" class="img-thumbnail" style="max-height: 150px; border-radius: 8px;">
                    </div>
                }

                <input type="file" asp-for="ImagenArchivo" id="inputImagen" class="form-control border-secondary-subtle" style="border-radius: 8px;" accept=".jpg,.jpeg,.png,.webp">
                <span class="text-muted small d-block mt-1">Carga un archivo nuevo únicamente si deseas reemplazar la imagen.</span>
                <span asp-validation-for="ImagenArchivo" class="text-danger small"></span>
            </div>

            <!-- VIDEO -->
            <div class="mb-4 d-none" id="sectionVideo">
                <label class="form-label fw-semibold text-muted small"><i class="bi bi-youtube"></i> Enlace de YouTube</label>
                <input type="url" asp-for="YouTubeVideoUrl" id="inputVideo" class="form-control border-secondary-subtle" style="border-radius: 8px;" placeholder="https://www.youtube.com/watch?v=...">
                <span asp-validation-for="YouTubeVideoUrl" class="text-danger small"></span>
            </div>

            <!-- CONFIGURACION EXTRA: PRIVACIDAD Y COMENTARIOS -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Privacidad" class="form-label fw-semibold text-muted small"><i class="bi bi-shield-lock"></i> Privacidad</label>
                    <select asp-for="Privacidad" class="form-select border-secondary-subtle" style="border-radius: 8px;">
                        <option value="SoloAmigos">👥 Solo Amigos</option>
                        <option value="SoloYo">🔒 Solo yo</option>
                    </select>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input border-secondary-subtle" type="checkbox" asp-for="PermiteComentarios" id="chkComentarios">
                        <label class="form-check-label fw-semibold text-muted small" for="chkComentarios">Permitir Comentarios</label>
                    </div>
                </div>
            </div>

            <!-- BOTONES DE ACCIÓN -->
            <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-4">
                <a asp-controller="Publicacion" asp-action="Index" class="btn btn-light px-4 border" style="border-radius: 20px; font-weight: 600;">
                    Volver atrás
                </a>
                <button type="submit" class="btn btn-primary px-4" style="border-radius: 20px; font-weight: 600; background: #5B4CFF; border: none;">
                    Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function conmutarTipoContenido() {
        var selector = document.getElementById("tipoContenidoSelect").value;
        var sectionImg = document.getElementById("sectionImagen");
        var sectionVid = document.getElementById("sectionVideo");
        var inputVid = document.getElementById("inputVideo");
        var inputImg = document.getElementById("inputImagen");

        if (selector === "Imagen") {
            sectionImg.classList.remove("d-none");
            sectionVid.classList.add("d-none");
            if (inputVid) inputVid.value = ""; 
        } else if (selector === "Video") {
            sectionVid.classList.remove("d-none");
            sectionImg.classList.add("d-none");
            if (inputImg) inputImg.value = ""; 
        }
    }

    document.addEventListener("DOMContentLoaded", function() {
        conmutarTipoContenido();
    });
</script>