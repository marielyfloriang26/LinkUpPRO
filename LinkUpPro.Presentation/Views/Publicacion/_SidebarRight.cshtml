            <h6 class="lup-widget__title">Personas que quizás conozcas</h6>
            @for (int i = 0; i < 3; i++)
            {
                <div class="lup-suggestion">
                    <img src="https://cdn-icons-png.flaticon.com/512/149/149071.png"
                         alt="Sugerencia" class="lup-avatar lup-avatar--sm">
                    <div class="lup-suggestion__info">
                        <p class="lup-suggestion__name">Usuario sugerido</p>
                        <p class="lup-suggestion__role">Profesional · LinkUpPro</p>
