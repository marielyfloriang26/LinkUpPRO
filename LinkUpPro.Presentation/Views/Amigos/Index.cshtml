@model LinkUpPro.Presentation.ViewModels.Amigo.AmigoListViewModel

@{
    ViewData["Title"] = "Mis Amigos";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-5 fw-bold text-primary mb-3">Mis Amigos</h1>
            
            <form asp-action="Buscar" method="get" class="d-flex">
                <input type="text" name="query" value="@Model.SearchQuery" class="form-control me-2 rounded-pill shadow-sm" placeholder="Buscar por nombre o usuario..." />
                <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Buscar</button>
            </form>
        </div>
        
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-light">
                <div class="card-body">
                    <h5 class="card-title fw-bold text-secondary">Resumen de amistades</h5>
                    <h2 class="display-4 text-primary fw-bold mb-0">@Model.TotalAmigos</h2>
                    <p class="text-muted mb-0">Amigos en total</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (Model.Amigos != null && Model.Amigos.Count > 0)
        {
            @foreach (var amigo in Model.Amigos)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 hover-card transition-all">
                        <div class="card-body text-center">
                            <img src="@(string.IsNullOrEmpty(amigo.FotoPerfilUrl) ? "/img/default.png" : amigo.FotoPerfilUrl)" alt="Foto de @amigo.NombreCompleto" class="rounded-circle mb-3 shadow-sm object-fit-cover" style="width: 100px; height: 100px;">
                            <h5 class="card-title fw-bold mb-1">@amigo.NombreCompleto</h5>
                            <p class="text-muted small mb-2">@@@amigo.NombreUsuario</p>
                            <p class="mb-2"><span class="badge bg-secondary">@amigo.Profesion</span></p>
                            <p class="text-info small fw-bold mb-3"><i class="bi bi-people-fill me-1"></i>@amigo.AmigosEnComun amigos en común</p>
                            
                            <a asp-action="Eliminar" asp-route-id="@amigo.Id" class="btn btn-outline-danger btn-sm rounded-pill w-100">Eliminar amigo</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center rounded-4 shadow-sm">
                    <i class="bi bi-info-circle-fill me-2"></i>No tienes amigos agregados aún o no se encontraron resultados.
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
    .transition-all {
        transition: all 0.3s ease;
    }
</style>
