@model LinkUpPro.Presentation.ViewModels.Amigo.AmigoViewModel

@{
    ViewData["Title"] = "Eliminar Amigo";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <div class="card-header bg-danger text-white text-center py-3">
                    <h4 class="mb-0 fw-bold">Confirmar Eliminación</h4>
                </div>
                <div class="card-body text-center p-5">
                    <i class="bi bi-exclamation-triangle-fill text-warning display-1 mb-3 d-block"></i>
                    <h5 class="mb-4">¿Estás seguro que deseas eliminar a <strong>@Model.NombreCompleto</strong> de tu lista de amigos?</h5>
                    
                    <form asp-action="Eliminar" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4 shadow-sm me-md-2">Cancelar</a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">Sí, eliminar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
