@model LinkUpPro.Application.ViewModels.User.ForgotPasswordViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark text-center">
                    <h3>Restablecer Contraseña</h3>
                </div>
                <div class="card-body">
                    <form asp-action="ForgotPassword" method="post">
                        <div class="form-group mb-3">
                            <label class="form-label">Nombre de usuario</label>
                            <input asp-for="NombreUsuario" class="form-control" required />
                            <span asp-validation-for="NombreUsuario" class="text-danger"></span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <a asp-action="Login" class="btn btn-secondary">Volver atrás</a>
                            <button type="submit" class="btn btn-warning">Enviar enlace</button>
                        </div>
                    </form>
                    @if (ViewBag.Message != null) { <div class="alert alert-info mt-3">@ViewBag.Message</div> }
                </div>
            </div>
        </div>
    </div>
</div>
</div>