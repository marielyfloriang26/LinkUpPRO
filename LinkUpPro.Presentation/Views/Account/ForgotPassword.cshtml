@model LinkUpPro.Application.ViewModels.User.ForgotPasswordViewModel

<div class="container mt-5">
    <h2>Restablecer contraseña</h2>
    <form asp-action="ForgotPassword" method="post">
        <div class="mb-3">
            <input asp-for="NombreUsuario" class="form-control" placeholder="Ingrese su nombre de usuario" />
            <span asp-validation-for="NombreUsuario" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Enviar enlace</button>
        <a asp-action="Login" class="btn btn-secondary">Volver atrás</a>
    </form>
    @if (ViewBag.Message != null) { <div class="alert alert-info mt-3">@ViewBag.Message</div> }
</div>