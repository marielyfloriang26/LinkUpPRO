@{
    ViewData["Title"] = "Correo de activación reenviado";
    Layout = "_Layout"; // ESTO ES LO QUE FALTA
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <h2 class="text-success">¡Correo enviado!</h2>
            <p>Hemos enviado un nuevo enlace de activación a tu dirección de correo electrónico.</p>
            <p>Por favor, revisa tu bandeja de entrada (y la carpeta de spam).</p>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-3">Volver al inicio de sesión</a>
        </div>
    </div>
</div>