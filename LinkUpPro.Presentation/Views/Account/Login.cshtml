@model LinkUpPro.Application.ViewModels.User.LoginViewModel
@{ ViewData["Title"] = "Iniciar Sesión"; }

<div class="container mt-5">
    <div class="card shadow-sm p-4 col-md-6 mx-auto">
        <h2 class="text-center">Iniciar Sesión</h2>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="mb-3">
                <label>Nombre de Usuario</label>
                <input asp-for="NombreUsuario" class="form-control" />
                <span asp-validation-for="NombreUsuario" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label>Contraseña</label>
                <div class="input-group">
                    <input asp-for="Password" type="password" id="loginPass" class="form-control" />
                    <button type="button" class="btn btn-outline-secondary" onclick="togglePass('loginPass')">👁️</button>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="MantenerSesion" class="form-check-input" />
                <label class="form-check-label">Mantener sesión iniciada</label>
                <small class="text-muted d-block">Seleccione esta opción únicamente si está utilizando un dispositivo personal.</small>
            </div>

            <button type="submit" class="btn btn-primary w-100">Iniciar sesión</button>
        </form>

        <div class="mt-3 text-center">
            <a asp-action="Register">Registrarse</a> | 
            <a asp-action="ForgotPassword">Restablecer contraseña</a> |
            <a asp-action="ResendEmail">Reenviar correo de activación</a>
        </div>
    </div>
</div>

<script>
    function togglePass(id) {
        const input = document.getElementById(id);
        input.type = (input.type === "password") ? "text" : "password";
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}