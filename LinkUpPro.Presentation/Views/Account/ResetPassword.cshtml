@model LinkUpPro.Application.ViewModels.User.ResetPasswordViewModel

<div class="container mt-5">
    <h2>Restablecer Contraseña</h2>
    <form asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="Token" />
        <input type="hidden" asp-for="Email" />

        <div class="mb-3">
            <label>Nueva Contraseña</label>
            <div class="input-group">
                <input asp-for="Password" id="newPass" type="password" class="form-control" />
                <button type="button" class="btn btn-outline-secondary" onclick="toggleVisibility('newPass')">👁️</button>
            </div>
        </div>

        <div class="mb-3">
            <label>Confirmar Nueva Contraseña</label>
            <div class="input-group">
                <input asp-for="ConfirmPassword" id="confNewPass" type="password" class="form-control" />
                <button type="button" class="btn btn-outline-secondary" onclick="toggleVisibility('confNewPass')">👁️</button>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Guardar Contraseña</button>
    </form>
</div>

<script>
    function toggleVisibility(id) {
        const input = document.getElementById(id);
        input.type = (input.type === "password") ? "text" : "password";
    }
</script>