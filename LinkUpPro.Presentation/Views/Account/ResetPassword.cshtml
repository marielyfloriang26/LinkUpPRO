@model LinkUpPro.Application.Account.ViewModels.ResetPasswordViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-danger text-white text-center">
                    <h3>Crear Nueva Contraseña</h3>
                </div>
                <div class="card-body">
                    <form asp-action="ResetPassword" method="post">
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="Token" />

                        <div class="form-group mb-3">
                            <label class="form-label">Nueva contraseña</label>
                            <div class="input-group">
                                <input asp-for="Contraseña" type="password" id="p1" class="form-control" />
                                <button class="btn btn-outline-secondary" type="button" onclick="toggle('p1', this)">👁️</button>
                            </div>
                            <div class="progress mt-2" style="height: 8px;">
                                <div id="sBar" class="progress-bar" style="width: 0%"></div>
                            </div>
                            <small id="sText" class="text-muted d-block mt-1"></small>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label">Confirmar contraseña</label>
                            <div class="input-group">
                                <input asp-for="ConfirmarContraseña" type="password" id="p2" class="form-control" />
                                <button class="btn btn-outline-secondary" type="button" onclick="toggle('p2', this)">👁️</button>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-danger w-100">Restablecer contraseña</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function toggle(id, btn) {
    let input = document.getElementById(id);
    input.type = input.type === "password" ? "text" : "password";
    btn.textContent = input.type === "password" ? "👁️" : "🔒";
}
document.getElementById('p1').addEventListener('input', function() {
    let v = this.value; let score = 0;
    if(v.length >= 8) score++; if(/[A-Z]/.test(v)) score++; if(/[a-z]/.test(v)) score++; if(/[0-9]/.test(v)) score++; if(/[^A-Za-z0-9]/.test(v)) score++;
    let bar = document.getElementById('sBar'); let txt = document.getElementById('sText');
    if(v.length === 0) { bar.style.width="0%"; txt.textContent=""; }
    else if(score <= 2) { bar.className="progress-bar bg-danger"; bar.style.width="33%"; txt.textContent="Débil"; }
    else if(score <= 4) { bar.className="progress-bar bg-warning"; bar.style.width="66%"; txt.textContent="Media"; }
    else { bar.className="progress-bar bg-success"; bar.style.width="100%"; txt.textContent="Fuerte"; }
});
</script>