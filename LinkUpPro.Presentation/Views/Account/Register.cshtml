@model LinkUpPro.Application.ViewModels.User.RegisterViewModel

@{
    ViewData["Title"] = "Registro";
}

<div class="container mt-5">
    <h2>Crear Cuenta</h2>
    <form asp-action="Register" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger"></div>
        
        <div class="row">
            <div class="col-md-6">
                <input asp-for="Nombre" class="form-control" placeholder="Nombre" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <input asp-for="Apellido" class="form-control" placeholder="Apellido" />
                <span asp-validation-for="Apellido" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-3">
            <input asp-for="NombreUsuario" class="form-control" placeholder="Nombre de Usuario" />
            <span asp-validation-for="NombreUsuario" class="text-danger"></span>
        </div>

        <div class="mt-3">
            <input asp-for="Correo" class="form-control" placeholder="Correo Electrónico" />
            <span asp-validation-for="Correo" class="text-danger"></span>
        </div>

        <div class="mt-3">
            <input asp-for="Telefono" class="form-control" placeholder="Teléfono (809-XXX-XXXX)" />
            <span asp-validation-for="Telefono" class="text-danger"></span>
        </div>

        <div class="mt-3">
            <label>Foto de Perfil</label>
            <input asp-for="FotoPerfil" type="file" class="form-control" />
            <span asp-validation-for="FotoPerfil" class="text-danger"></span>
        </div>

        <div class="mt-3">
            <div class="input-group">
                <input asp-for="Password" id="pass" type="password" class="form-control" placeholder="Contraseña" />
                <button type="button" class="btn btn-outline-secondary" onclick="toggleVisibility('pass')">👁️</button>
            </div>
            <div id="strength-indicator" class="fw-bold mt-1"></div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mt-3">
            <div class="input-group">
                <input asp-for="ConfirmPassword" id="confPass" type="password" class="form-control" placeholder="Confirmar Contraseña" />
                <button type="button" class="btn btn-outline-secondary" onclick="toggleVisibility('confPass')">👁️</button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary mt-4">Registrarse</button>
        <a asp-action="Login" class="btn btn-link mt-4">Volver atrás</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleVisibility(id) {
            const input = document.getElementById(id);
            input.type = (input.type === "password") ? "text" : "password";
        }

        document.getElementById('pass').addEventListener('input', function() {
            const val = this.value;
            let score = 0;
            if (val.length >= 8) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[a-z]/.test(val)) score++;
            if (/\d/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            const indicator = document.getElementById('strength-indicator');
            if (val.length === 0) { indicator.innerText = ""; }
            else if (score <= 2) { indicator.innerText = "Débil"; indicator.style.color = "red"; }
            else if (score <= 4) { indicator.innerText = "Media"; indicator.style.color = "orange"; }
            else { indicator.innerText = "Fuerte"; indicator.style.color = "green"; }
        });
    </script>
}