<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LinkUpPro</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LinkUpPro.Presentation.styles.css" asp-append-version="true" />
    <style>
        .navbar-brand { font-weight: 800; color: #0d6efd !important; letter-spacing: -0.5px; }
        .nav-link { font-weight: 500; transition: color 0.2s; }
        .nav-link:hover { color: #0d6efd !important; }
        body { background-color: #f8f9fa; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom shadow-sm mb-4">
            <div class="container-fluid px-4">
                <a class="navbar-brand fs-3" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-link-45deg"></i> LinkUpPro
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @using Microsoft.AspNetCore.Identity
                    @using LinkUpPro.Domain.Entities
                    @using LinkUpPro.Application.Interfaces.Services
                    @inject SignInManager<Usuario> SignInManager
                    @inject ISolicitudAmistadService SolicitudService

                    @{
                        int pendingSolicitudes = 0;
                        try
                        {
                            if (SignInManager.IsSignedIn(User))
                            {
                                var userId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");
                                var recibidas = await SolicitudService.GetSolicitudesRecibidasAsync(userId);
                                pendingSolicitudes = recibidas.Count(s => s.Estado == "En espera de respuesta");
                            }
                        }
                        catch
                        {
                            // Fail silently for UI badge
                        }
                    }

                    <ul class="navbar-nav flex-grow-1 align-items-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item ms-lg-3">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door me-1"></i>Inicio
                                </a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Amigos" asp-action="Index">
                                    <i class="bi bi-people me-1"></i>Amigos
                                </a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="nav-link text-dark position-relative" asp-area="" asp-controller="Solicitudes" asp-action="Index">
                                    <i class="bi bi-person-plus me-1"></i>Solicitudes
                                    @if (pendingSolicitudes > 0)
                                    {
                                        <span class="badge rounded-pill bg-danger text-xs align-middle ms-1" style="font-size: 0.65rem;">
                                            @pendingSolicitudes
                                        </span>
                                    }
                                </a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="nav-link text-dark fw-bold" asp-area="" asp-controller="Publicacion" asp-action="Index">Publicaciones</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-5">
            <div class="container mt-3">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            </div>
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container text-center">
            &copy; 2026 - LinkUpPro - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacidad</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
