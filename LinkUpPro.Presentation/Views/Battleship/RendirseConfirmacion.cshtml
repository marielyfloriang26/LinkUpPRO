@{
    ViewData["Title"] = "Rendirse";
}

<div class="container mt-4 text-center">
    <div class="card mx-auto mt-5" style="max-width: 400px;">
        <div class="card-body">
            <h5 class="card-title">Rendirse</h5>
            <p class="card-text">¿Está seguro que desea rendirse?</p>
            <div class="mt-4">
                @if (ViewBag.Origen == "Jugar")
                {
                    <a asp-action="Jugar" asp-route-partidaId="@ViewBag.PartidaId" class="btn btn-secondary">Cancelar</a>
                }
                else
                {
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                }
                <form asp-action="Rendirse" method="post" style="display:inline;">
                    <input type="hidden" name="partidaId" value="@ViewBag.PartidaId" />
                    <button type="submit" class="btn btn-danger">Aceptar</button>
                </form>
            </div>
        </div>
    </div>
</div>
