@model LinkUpPro.Application.ViewModels.Battleship.TableroViewModel

@{
    ViewData["Title"] = "Partida en curso";
}

<div class="container mt-4 text-center">
    <h2>Tablero de Ataque</h2>
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="d-inline-block border bg-light p-2 mx-auto">
            @for (int i = 1; i <= 12; i++)
            {
                <div class="d-flex">
                    @for (int j = 1; j <= 12; j++)
                    {
                        var casilla = Model.CasillasOponente.FirstOrDefault(c => c.Fila == i && c.Columna == j);
                        
                        if (casilla != null)
                        {
                            if (casilla.TieneBarco)
                            {
                                <div class="bg-danger border" style="width: 40px; height: 40px; margin: 1px;"></div>
                            }
                            else
                            {
                                <div class="bg-success border" style="width: 40px; height: 40px; margin: 1px;"></div>
                            }
                        }
                        else
                        {
                            if (Model.EsMiTurno)
                            {
                                <form asp-action="Atacar" method="post" style="margin: 0;">
                                    <input type="hidden" name="partidaId" value="@Model.PartidaId" />
                                    <input type="hidden" name="fila" value="@i" />
                                    <input type="hidden" name="columna" value="@j" />
                                    <button type="submit" class="bg-white border" style="width: 40px; height: 40px; margin: 1px;"></button>
                                </form>
                            }
                            else
                            {
                                <div class="bg-white border" style="width: 40px; height: 40px; margin: 1px;"></div>
                            }
                        }
                    }
                </div>
            }
        </div>
        
        <div class="mt-3 mb-3">
            @if (!Model.EsMiTurno)
            {
                <span class="fs-5 text-muted">Es turno del jugador @Model.OponenteNombre de atacar</span>
            }
        </div>
        
        <div class="mt-4">
            <a asp-action="Jugar" asp-route-partidaId="@Model.PartidaId" class="btn btn-info">Refrescar pantalla</a>
            <a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
            <a asp-action="VerMiTablero" asp-route-partidaId="@Model.PartidaId" class="btn btn-primary">Ver mi tablero</a>
            <a asp-action="RendirseConfirmacion" asp-route-partidaId="@Model.PartidaId" asp-route-origen="Jugar" class="btn btn-danger">Rendirse</a>
        </div>
</div>
