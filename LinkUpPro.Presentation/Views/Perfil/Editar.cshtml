@model LinkUpPro.Application.ViewModels.MiPerfil.PerfilViewModel

@{
    ViewData["Title"] = "Editar Perfil";
}

<link rel="stylesheet" href="~/css/publicaciones.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="lup-layout">
    <!-- SIDEBAR IZQUIERDO -->
    @await Html.PartialAsync("~/Views/Publicacion/_SidebarLeft.cshtml")

    <!-- SECCIÓN CENTRAL DE EDICIÓN -->
    <main class="lup-feed">
        <div class="card border-0 shadow-sm p-4" style="border-radius: 16px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
            <h3 class="fw-bold mb-4" style="color: #2D275A;">Editar Información</h3>

            <form asp-controller="Perfil" asp-action="Editar" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <!-- CAMBIAR FOTO DE PERFIL -->
                <div class="text-center mb-4">
                    <div class="position-relative d-inline-block">
                        <img id="avatarPreview" src="@(string.IsNullOrEmpty(Model.FotoPerfilUrl) ? "https://cdn-icons-png.flaticon.com/512/149/149071.png" : Model.FotoPerfilUrl)"
                             alt="Avatar" class="rounded-circle shadow-sm" style="width: 120px; height: 120px; object-fit: cover; border: 4px solid #fff;">
                        
                        <label for="FotoPerfilInput" class="btn btn-sm btn-primary position-absolute bottom-0 end-0 rounded-circle d-flex align-items-center justify-content-center" 
                               style="width: 32px; height: 32px; background: #5B4CFF; border: none; cursor: pointer;">
                            <i class="bi bi-camera-fill text-white" style="font-size: 0.9rem;"></i>
                            <input type="file" id="FotoPerfilInput" name="FotoPerfil" class="d-none" accept=".jpg,.jpeg,.png,.webp" onchange="previewImage(this)" />
                        </label>
                    </div>
                    <div class="small text-muted mt-2">Formatos válidos: .jpg, .png, .webp (máx. 5MB)</div>
                    <span asp-validation-for="FotoPerfil" class="text-danger small d-block mt-1"></span>
                </div>

                <!-- CAMPOS DE SOLO LECTURA -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">Nombre de Usuario</label>
                        <input type="text" class="form-control bg-light" value="@Model.NombreUsuario" readonly style="border-radius: 8px; border: 1px solid #dee2e6;" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">Correo Electrónico</label>
                        <input type="text" class="form-control bg-light" value="@Model.Correo" readonly style="border-radius: 8px; border: 1px solid #dee2e6;" />
                    </div>
                </div>

                <hr class="my-4 text-muted">

                <!-- INFORMACIÓN PERSONAL EDITABLE -->
                <h5 class="fw-bold mb-3" style="color: #2D275A;">Información Personal</h5>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">Nombre</label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ingresa tu nombre" style="border-radius: 8px;" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Apellido" class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">Apellido</label>
                        <input asp-for="Apellido" class="form-control" placeholder="Ingresa tu apellido" style="border-radius: 8px;" />
                        <span asp-validation-for="Apellido" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3 col-md-6">
                    <label asp-for="Telefono" class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">Teléfono</label>
                    <input asp-for="Telefono" class="form-control" placeholder="ej. 809-555-1234" style="border-radius: 8px;" />
                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                </div>

                <hr class="my-4 text-muted">

                <!-- CAMBIO OPCIONAL DE CONTRASEÑA -->
                <h5 class="fw-bold mb-3" style="color: #2D275A;">Cambiar Contraseña <span class="fw-normal text-muted" style="font-size: 0.8rem;">(Opcional)</span></h5>
                
                <div class="mb-3">
                    <label asp-for="PasswordActual" class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">Contraseña Actual</label>
                    <div class="input-group">
                        <input asp-for="PasswordActual" type="password" id="inputActual" class="form-control" style="border-radius: 8px 0 0 8px;" />
                        <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('inputActual', 'iconActual')" style="border-radius: 0 8px 8px 0;">
                            <i id="iconActual" class="bi bi-eye-fill"></i>
                        </button>
                    </div>
                    <span asp-validation-for="PasswordActual" class="text-danger small"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="PasswordNuevo" class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">Nueva Contraseña</label>
                        <div class="input-group">
                            <input asp-for="PasswordNuevo" type="password" id="inputNuevo" class="form-control" onkeyup="checkStrength(this.value)" style="border-radius: 8px 0 0 8px;" />
                            <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('inputNuevo', 'iconNuevo')" style="border-radius: 0 8px 8px 0;">
                                <i id="iconNuevo" class="bi bi-eye-fill"></i>
                            </button>
                        </div>
                        <span asp-validation-for="PasswordNuevo" class="text-danger small"></span>

                        <!-- Indicador de Fortaleza -->
                        <div class="mt-2">
                            <div class="progress" style="height: 6px;">
                                <div id="strengthBar" class="progress-bar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <span id="strengthText" class="small fw-semibold mt-1 d-block text-muted">Contraseña no ingresada</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PasswordConfirmacion" class="form-label fw-semibold text-secondary" style="font-size: 0.85rem;">Confirmar Contraseña</label>
                        <div class="input-group">
                            <input asp-for="PasswordConfirmacion" type="password" id="inputConfirmacion" class="form-control" style="border-radius: 8px 0 0 8px;" />
                            <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('inputConfirmacion', 'iconConfirmacion')" style="border-radius: 0 8px 8px 0;">
                                <i id="iconConfirmacion" class="bi bi-eye-fill"></i>
                            </button>
                        </div>
                        <span asp-validation-for="PasswordConfirmacion" class="text-danger small"></span>
                    </div>
                </div>

                <!-- ACCIONES -->
                <div class="d-flex justify-content-between mt-4">
                    <a asp-controller="Perfil" asp-action="Index" class="btn btn-light fw-bold px-4" style="border-radius: 8px; border: 1px solid #dee2e6;">Volver atrás</a>
                    <button type="submit" class="btn btn-primary fw-bold px-5 text-white" style="background: #5B4CFF; border: none; border-radius: 8px;">Guardar cambios</button>
                </div>
            </form>
        </div>
    </main>
</div>

<script>
    // Mostrar/ocultar contraseñas
    function togglePassword(inputId, iconId) {
        var input = document.getElementById(inputId);
        var icon = document.getElementById(iconId);
        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove("bi-eye-fill");
            icon.classList.add("bi-eye-slash-fill");
        } else {
            input.type = "password";
            icon.classList.remove("bi-eye-slash-fill");
            icon.classList.add("bi-eye-fill");
        }
    }

    // Previsualizar la foto de perfil antes de guardar
    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('avatarPreview').src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    // Comprobador visual de la fortaleza de la contraseña
    function checkStrength(password) {
        var bar = document.getElementById('strengthBar');
        var text = document.getElementById('strengthText');
        
        if (!password) {
            bar.style.width = '0%';
            bar.className = 'progress-bar';
            text.innerText = 'Contraseña no ingresada';
            text.className = 'small fw-semibold mt-1 d-block text-muted';
            return;
        }

        var criteriaCount = 0;
        if (password.length >= 8) criteriaCount++;
        if (/[A-Z]/.test(password)) criteriaCount++;
        if (/[a-z]/.test(password)) criteriaCount++;
        if (/[0-9]/.test(password)) criteriaCount++;
        if (/[^A-Za-z0-9]/.test(password)) criteriaCount++;

        if (criteriaCount <= 2) {
            bar.style.width = '33%';
            bar.className = 'progress-bar bg-danger';
            text.innerText = 'Débil';
            text.className = 'small fw-semibold mt-1 d-block text-danger';
        } else if (criteriaCount <= 4) {
            bar.style.width = '66%';
            bar.className = 'progress-bar bg-warning';
            text.innerText = 'Media';
            text.className = 'small fw-semibold mt-1 d-block text-warning';
        } else {
            bar.style.width = '100%';
            bar.className = 'progress-bar bg-success';
            text.innerText = 'Fuerte';
            text.className = 'small fw-semibold mt-1 d-block text-success';
        }
    }
</script>