@model LinkUpPro.Presentation.ViewModels.Solicitud.SolicitudesIndexViewModel

@{
    ViewData["Title"] = "Solicitudes de Amistad";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6 fw-bold text-primary">Solicitudes de Amistad</h1>
        <a asp-action="Nueva" class="btn btn-primary rounded-pill px-4 shadow-sm"><i class="bi bi-person-plus-fill me-2"></i>Buscar nuevos amigos</a>
    </div>

    <ul class="nav nav-pills mb-4 nav-fill bg-light rounded-pill p-1 shadow-sm" id="solicitudesTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill fw-bold" id="pendientes-tab" data-bs-toggle="tab" data-bs-target="#pendientes" type="button" role="tab" aria-controls="pendientes" aria-selected="true">
                Pendientes de responder <span class="badge bg-danger ms-2">@Model.Pendientes.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill fw-bold" id="enviadas-tab" data-bs-toggle="tab" data-bs-target="#enviadas" type="button" role="tab" aria-controls="enviadas" aria-selected="false">
                Enviadas <span class="badge bg-secondary ms-2">@Model.Enviadas.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content" id="solicitudesTabContent">
        <!-- Pendientes -->
        <div class="tab-pane fade show active" id="pendientes" role="tabpanel" aria-labelledby="pendientes-tab">
            <div class="row row-cols-1 row-cols-md-2 g-4">
                @if (Model.Pendientes.Count > 0)
                {
                    @foreach (var sol in Model.Pendientes)
                    {
                        <div class="col">
                            <div class="card border-0 shadow-sm rounded-4 h-100">
                                <div class="card-body d-flex align-items-center">
                                    <img src="@(string.IsNullOrEmpty(sol.FotoPerfilUrl) ? "/img/default.png" : sol.FotoPerfilUrl)" class="rounded-circle me-3 object-fit-cover shadow-sm" style="width: 60px; height: 60px;">
                                    <div class="flex-grow-1">
                                        <h5 class="mb-0 fw-bold">@sol.NombreCompleto</h5>
                                        <small class="text-muted">@@@sol.NombreUsuario</small>
                                        <p class="text-info small fw-bold mb-0 mt-1"><i class="bi bi-people-fill me-1"></i>@sol.AmigosEnComun amigos en común</p>
                                    </div>
                                    <div class="d-flex flex-column gap-2 ms-3">
                                        <form asp-action="Aceptar" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@sol.Id" />
                                            <button type="submit" class="btn btn-success btn-sm rounded-pill w-100 shadow-sm">Aceptar</button>
                                        </form>
                                        <form asp-action="Rechazar" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@sol.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill w-100 shadow-sm">Rechazar</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center text-muted my-5">
                        <i class="bi bi-inbox display-1 text-light mb-3"></i>
                        <p class="lead">No tienes solicitudes pendientes.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Enviadas -->
        <div class="tab-pane fade" id="enviadas" role="tabpanel" aria-labelledby="enviadas-tab">
            <div class="row row-cols-1 row-cols-md-2 g-4">
                @if (Model.Enviadas.Count > 0)
                {
                    @foreach (var sol in Model.Enviadas)
                    {
                        <div class="col">
                            <div class="card border-0 shadow-sm rounded-4 h-100">
                                <div class="card-body d-flex align-items-center">
                                    <img src="@(string.IsNullOrEmpty(sol.FotoPerfilUrl) ? "/img/default.png" : sol.FotoPerfilUrl)" class="rounded-circle me-3 object-fit-cover shadow-sm" style="width: 60px; height: 60px;">
                                    <div class="flex-grow-1">
                                        <h5 class="mb-0 fw-bold">@sol.NombreCompleto</h5>
                                        <small class="text-muted">@@@sol.NombreUsuario</small>
                                    </div>
                                    <div class="d-flex flex-column gap-2 ms-3">
                                        <form asp-action="Cancelar" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@sol.Id" />
                                            <button type="submit" class="btn btn-outline-warning btn-sm rounded-pill w-100 shadow-sm">Cancelar</button>
                                        </form>
                                        <form asp-action="EliminarHistorial" method="post" class="d-inline mt-1">
                                            <input type="hidden" name="id" value="@sol.Id" />
                                            <button type="submit" class="btn btn-light btn-sm rounded-pill w-100 text-muted" title="Eliminar del historial"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center text-muted my-5">
                        <i class="bi bi-send display-1 text-light mb-3"></i>
                        <p class="lead">No has enviado solicitudes recientemente.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
